  if(floor)gp.push([0,botLeft]);
  s+='<polygon points="'+gp.map(function(pp){return MX(pp[0])+','+fy(pp[1]);}).join(' ')+'" fill="rgba(70,150,190,0.24)" stroke="#2E6E8E" stroke-width="'+(sw*1.1)+'"/>';
  if(lamana){s+='<polyline points="'+MX(0)+','+fy(topYA)+' '+MX(kinkX)+','+fy(kinkY)+' '+MX(fullRun)+','+fy(kinkY)+'" fill="none" stroke="#2E6E8E" stroke-width="'+(sw*1.5)+'"/>';s+='<text x="'+MX((kinkX+fullRun)/2)+'" y="'+(fy(kinkY)-fs*0.6)+'" font-size="'+(fs*0.64)+'" font-family="ui-monospace,monospace" fill="#2E6E8E" text-anchor="middle">wzdłuż podłogi</text>';}else{s+='<line x1="'+MX(0)+'" y1="'+fy(topYA)+'" x2="'+MX(run)+'" y2="'+fy(topYB)+'" stroke="#2E6E8E" stroke-width="'+(sw*1.5)+'"/>';}
  var hAl=dOn?(fmtN(hA+d)+' ('+fmtN(hA)+'+'+fmtN(d)+' frez)'):fmtN(hA),hBl=dOn?(fmtN(hB+d)+' ('+fmtN(hB)+'+'+fmtN(d)+' frez)'):fmtN(hB);
  s+=szdim(MX(0),fy(Y[1]-d),MX(0),fy(topYA),hAl,MO(-pad*0.58),true,fs*0.92,sw,COLR,'szR',true);
  s+=szdim(MX(fullRun),fy(Y[n]-d),MX(fullRun),fy(topYB),hBl,MO(pad*0.58),true,fs*0.92,sw,COLR,'szR',true);
  for(var i=0;i<n;i++){s+=szdim(MX(gx[i]),fy(0),MX(gx[i+1]),fy(0),fmtN(gx[i+1]-gx[i]),pad*0.24,false,fs*0.7,sw,COLD,'szD',true);if(bOn&&b>0&&(i===0||i===n-1)){var fn=(i===0?fmtN(steps[0].d)+'+'+fmtN(b)+' frez':fmtN(steps[n-1].d)+' -'+fmtN(b)+' frez');s+='<text x="'+MX((gx[i]+gx[i+1])/2)+'" y="'+(fy(0)+pad*0.24+fs*1.75)+'" font-size="'+(fs*0.58)+'" font-family="ui-monospace,monospace" fill="#DC2626" text-anchor="middle">'+fn+'</text>';}}
  if(corr>0)s+=szdim(MX(run),fy(0),MX(fullRun),fy(0),fmtN(corr),pad*0.24,false,fs*0.72,sw,COLD,'szD',true);
  s+=szdim(MX(0),fy(0),MX(fullRun),fy(0),fmtN(fullRun),pad*0.85,false,fs,sw,COLN,'szN',true);
  for(var i=0;i<n;i++){if(i===0&&!floor)continue;s+=szdim(MX(gx[i]),fy(Y[i]),MX(gx[i]),fy(Y[i+1]),fmtN(steps[i].h),MO(-pad*0.13),true,fs*0.72,sw,COLH,'szH',true);}
  if(floor)s+='<text x="'+MX(run*0.5)+'" y="'+(fy(0)+fs*1.3)+'" font-size="'+(fs*0.7)+'" font-family="ui-monospace,monospace" fill="#7c5a25" text-anchor="middle">podłoga</text>';
  s+='<text x="'+MX(fullRun*0.4)+'" y="'+(fy((topYA+topYB)/2)-fs*0.7)+'" font-size="'+(fs*0.7)+'" font-family="ui-monospace,monospace" fill="#2E6E8E" text-anchor="middle">górna krawędź '+fmtN(topLen)+' cm</text>';
  s+='</svg>';
  return s;
}
function renderSzyba(){
  var out=document.getElementById("sz-output");if(!out)return;
  if(!szybaState.segs||!szybaState.segs.length){szybaBuildSegs();return;}
  var html="";
  szybaState.segs.forEach(function(seg,si){
    var X=0,Y=0;seg.steps.forEach(function(st){X+=st.d;Y+=st.h;});
    var topLen=0;
    html+='<div class="card"><div class="chead">Tafla '+(si+1)+' — rysunek + wymiary</div>';
    html+='<div class="draw">'+segGlassSVG(seg)+'</div>';
    html+='<table><tbody>';
    function ir(k,v){return '<tr><td class="name">'+k+'</td><td style="text-align:right">'+v+'</td></tr>';}
    html+=ir("Wys. początkowa","<b style=\"color:#DC2626\">"+fmtN(seg.hA)+" cm</b>")+ir("Wys. końcowa","<b style=\"color:#DC2626\">"+fmtN(seg.hB)+" cm</b>")
       +ir("Frez dolny",(seg.frezOn===false?"nie":fmtN(seg.frez)+" cm"))+ir("Frez boczny",(seg.frezBokOn!==true?"nie":fmtN(seg.frezBok||0)+" cm"))+ir("Start",seg.start==='podloga'?"od podłogi":"od 1 stopnia")+ir("Góra",seg.topMode==='lamana'?"łamana (podłoga)":"prosta")+(seg.topMode==='lamana'?ir("Korytarz",fmtN(seg.corridor||0)+" cm"):"")
       +ir("Liczba stopni",seg.steps.length)+ir("Długość (bieg)",fmtN(X)+" cm");
    html+='</tbody></table>';
    var prof="";seg.steps.forEach(function(st,i){prof+=(i?" · ":"")+fmtN(st.d)+"/"+fmtN(st.h);});
    html+='<p class="note"><b style="color:#2563EB">wysokość</b> · <b style="color:#EA580C">głębokość</b> · <b style="color:#DC2626">wys. szyby</b>. '+(seg.mirror?"Lustro (od prawej). ":"")+(seg.start==='stopien'?"Leży na 1 stopniu — pierwszy pion pominięty. ":"Od podłogi — pokazany pion do podłogi. ")+'Profil: '+prof+'.</p>';
    html+='<div class="chead" style="border-top:1px solid #EBEEF0">Notatki dla szklarza (Tafla '+(si+1)+')</div>';
    html+='<textarea oninput="szNotes('+si+',this.value)" placeholder="Np. szkło hartowane 10 mm, krawędzie polerowane..." style="width:100%;min-height:70px;border:none;padding:10px 16px;font:14px -apple-system,sans-serif;resize:vertical;outline:none;box-sizing:border-box;border-radius:0 0 10px 10px">'+(seg.notes||'')+'</textarea>';
    html+='</div>';
  });
  out.innerHTML=html;
}

function renderAll(){renderBrama();renderFurtka();renderDouble();renderWycinka();renderSchody();renderSzyba();}

/* ====== ZAPIS / WCZYTANIE PROJEKTU ====== */
function collectState(){
  var inputs={};
  document.querySelectorAll('input,textarea').forEach(function(el){if(el.id&&el.type!=='file')inputs[el.id]=el.value;});
  return {v:2,inputs:inputs,szyba:(typeof szybaState!=='undefined'?szybaState.segs:null),schody:(typeof schodyState!=='undefined'?schodyState.segs:null)};
}
function applyState(data){
  if(!data)return;
  try{
    if(data.schody&&typeof schodyState!=='undefined'){schodyState.segs=JSON.parse(JSON.stringify(data.schody));schodyState._sb=[];}
    if(data.szyba&&typeof szybaState!=='undefined'){szybaState.segs=JSON.parse(JSON.stringify(data.szyba));szybaState._sb=[];}
    if(data.inputs)Object.keys(data.inputs).forEach(function(id){var el=document.getElementById(id);if(el&&el.type!=='file')el.value=data.inputs[id];});
    if(typeof schodyEditors==='function')schodyEditors();
    if(typeof szybaEditors==='function')szybaEditors();
    renderAll();
  }catch(e){}
}
function saveProject(){
  try{
    var nm=((document.getElementById('uwagi')||{}).value||'projekt').replace(/[^a-zA-Z0-9ąćęłńóśźżĄĆĘŁŃÓŚŹŻ _-]+/g,'').trim().replace(/\s+/g,'_').slice(0,40)||'projekt';
    var blob=new Blob([JSON.stringify(collectState())],{type:'application/json'});
    var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='mexakolor-'+nm+'.json';
    document.body.appendChild(a);a.click();setTimeout(function(){a.remove();URL.revokeObjectURL(a.href);},100);
  }catch(e){alert('Nie udało się zapisać pliku.');}
}
function loadProject(file){
  if(!file)return;
  var r=new FileReader();
  r.onload=function(e){try{applyState(JSON.parse(e.target.result));autoSave();}catch(err){alert('Nieprawidłowy plik projektu.');}};
  r.readAsText(file);
}
function autoSave(){try{localStorage.setItem('mexakolor-autosave',JSON.stringify(collectState()));}catch(e){}}
function autoRestore(){try{var s=localStorage.getItem('mexakolor-autosave');if(s)applyState(JSON.parse(s));}catch(e){}}

schodyBuildSegs();
szybaBuildSegs();
renderAll();
autoRestore();
var _asT;document.addEventListener('input',function(){clearTimeout(_asT);_asT=setTimeout(autoSave,700);});
if(inPreview()){document.getElementById("printhelp").style.display="block";}
</script>
