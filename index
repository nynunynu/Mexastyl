<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Generator konstrukcji stalowych</title>
<style>
  :root{--ink:#1C2530;--paper:#FBFBF9;--steel:#DEE3E8;--picket:#C4CCD4;
    --dim:#3E6B7A;--accent:#E8792B;--line:#D5DAE0;--swiatlo:#B0762A;}
  *{box-sizing:border-box}
  body{margin:0;background:#EFF1F3;color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  .wrap{max-width:1000px;margin:0 auto;padding:16px}
  header{border-bottom:2px solid var(--ink);padding-bottom:14px;margin-bottom:16px;
    display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}
  h1{font-size:22px;margin:0;letter-spacing:-.3px}
  header p{margin:4px 0 0;font-size:13px;color:#64748b}
  .btn{background:var(--accent);color:#fff;border:none;border-radius:8px;
    padding:10px 16px;font-size:14px;font-weight:600;cursor:pointer}
  .btn:active{opacity:.85}
  .tabs{display:flex;gap:6px;margin-bottom:18px;flex-wrap:wrap}
  .tab{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 14px;
    font-size:14px;font-weight:600;cursor:pointer;color:#64748b}
  .tab.on{background:var(--ink);color:#fff;border-color:var(--ink)}
  .grid{display:grid;gap:20px}
  @media(min-width:860px){.grid{grid-template-columns:300px 1fr}}
  .card{background:#fff;border:1px solid var(--line);border-radius:10px}
  .panel{padding:16px}
  .glabel{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;
    color:#64748b;margin:14px 0 8px}
  .glabel:first-child{margin-top:0}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  label.f{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:500}
  .inp{display:flex;border:1px solid #C9CFD6;border-radius:6px;overflow:hidden}
  .inp input{width:100%;border:none;padding:9px 10px;font:15px ui-monospace,monospace;outline:none}
  .inp input:focus{box-shadow:inset 0 0 0 2px var(--accent)}
  .inp .u{display:flex;align-items:center;background:#F1F3F5;padding:0 9px;
    font:12px ui-monospace,monospace;color:#94a3b8}
  .seg{display:grid;gap:6px;margin-top:6px}
  .seg button{border:1px solid var(--line);background:#fff;border-radius:6px;
    padding:9px 12px;text-align:left;font-size:13px;cursor:pointer}
  .seg button.on{border-color:var(--accent);background:#FDF1E7;font-weight:600}
  .info{background:#FBF3E9;border:1px solid #E6D2B4;border-radius:6px;padding:9px 11px;
    font-size:12.5px;line-height:1.5;color:#7c5a25}
  .info b{font-family:ui-monospace,monospace}
  .chead{border-bottom:1px solid #EBEEF0;padding:11px 16px;font-size:14px;font-weight:700}
  .chead .muted{font-weight:400;color:#94a3b8}
  .draw{background:var(--paper);padding:12px}
  svg{width:100%;max-height:480px;display:block}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th{text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.4px;
    color:#64748b;font-weight:600;padding:8px 16px}
  td{padding:10px 16px;border-top:1px solid #F0F2F4;font-family:ui-monospace,monospace}
  td.name{font-family:inherit}
  .mgrid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#EBEEF0}
  @media(min-width:640px){.mgrid{grid-template-columns:repeat(4,1fr)}}
  .mcell{background:#fff;padding:14px}
  .mcell .k{font-size:12px;text-transform:uppercase;letter-spacing:.4px;color:#64748b}
  .mcell .v{font:700 18px ui-monospace,monospace;margin-top:3px}
  .mcell .s{font:13px ui-monospace,monospace;color:#94a3b8}
  .note{padding:12px 16px;font-size:12px;line-height:1.5;color:#94a3b8}
  .err{padding:20px;color:#dc2626;font-size:14px}
  .steplist{max-height:270px;overflow-y:auto;margin-top:2px;padding-right:4px}
  .srow{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:6px;align-items:center;margin-bottom:5px}
  .srow .sn{font-size:12.5px;color:#64748b;font-weight:600}
  .srow .inp input{padding:6px 8px;font-size:13px}
  .stack>*+*{margin-top:20px}
  .hide{display:none}
  .print-only{display:none}
  .brand{display:flex;align-items:center;gap:14px}
  .logo{height:46px;width:auto;border-radius:6px;display:block}
  .notesbar{margin:-2px 0 18px}
  .notesbar label{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600;color:#475569}
  .notesbar input{flex:1;border:1px solid var(--line);border-radius:8px;padding:10px 12px;
    font:15px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;outline:none;background:#fff}
  .notesbar input:focus{box-shadow:0 0 0 2px var(--accent)}
  .phelp{background:#FDF1E7;border:1px solid var(--accent);border-radius:8px;
    padding:12px 14px;margin:0 0 18px;font-size:13px;line-height:1.55;color:#7c4a1e}
  .phelp b{color:#5a3413}
  @media print{
    @page{margin:12mm}
    body{background:#fff}
    .screen-only,.tabs,.btn,.notesbar,.panel-col{display:none!important}
    .print-only{display:block!important}
    section.hide{display:none!important}
    .grid{grid-template-columns:1fr!important}
    header{border-color:#000}
    .card{break-inside:avoid;border-color:#999}
    .logo{height:56px}
    .draw{background:#fff}
    .draw svg{max-height:260px!important}
    #sz-output textarea,#s-steps,.steplist{max-height:none}
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <img class="logo" src="data:image/jpeg;base64," alt="MEXA KOLOR">
      <div>
        <h1>Generator konstrukcji stalowych</h1>
        <p class="screen-only">Rysunek dla spawacza i lista materiału. Podajesz <b>światło</b> — program liczy skrzydła.</p>
        <p class="print-only" id="print-meta"></p>
      </div>
    </div>
    <div class="screen-only" style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;align-items:center">
      <button class="btn" onclick="saveProject()">💾 Zapisz</button>
      <button class="btn" onclick="document.getElementById('loadfile').click()">📂 Wczytaj</button>
      <button class="btn" onclick="doPrint()">Drukuj / PDF</button>
    </div>
    <input id="loadfile" type="file" accept="application/json,.json" style="display:none" onchange="loadProject(this.files&&this.files[0]);this.value='';">
  </header>

  <div class="notesbar screen-only">
    <label>Uwagi / nazwa:
      <input id="uwagi" type="text" placeholder="np. Brama sąsiada — opcjonalnie">
    </label>
  </div>

  <div id="printhelp" class="phelp screen-only" style="display:none">
    <b>Nie pojawiło się okno drukowania?</b>
    Jesteś w podglądzie, który blokuje druk. Kliknij <b>Publish</b> i otwórz link w Safari —
    albo pobierz plik i otwórz w przeglądarce — a potem <b>Drukuj / PDF</b> → „Zapisz jako PDF".
  </div>

  <div class="tabs" id="tabs">
    <button class="tab on" data-t="brama">Brama / przęsło</button>
    <button class="tab" data-t="furtka">Furtka</button>
    <button class="tab" data-t="double">Brama 2-skrzydłowa</button>
    <button class="tab" data-t="wycinka">Wycinka / blacha</button>
    <button class="tab" data-t="schody">Schody</button>
    <button class="tab" data-t="szyba">Szyba / barierka</button>
  </div>

  <!-- ================= BRAMA / PRZĘSŁO ================= -->
  <section id="page-brama">
    <div class="grid">
      <div class="card panel panel-col">
        <div class="glabel">Wymiary zewnętrzne konstrukcji</div>
        <div class="row">
          <label class="f">Szerokość<span class="inp"><input id="b-width" type="number" value="400"><span class="u">cm</span></span></label>
          <label class="f">Wysokość<span class="inp"><input id="b-height" type="number" value="150"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Profil ramy</div>
        <div class="row">
          <label class="f">Bok<span class="inp"><input id="b-face" type="number" value="10"><span class="u">cm</span></span></label>
          <label class="f">Grubość<span class="inp"><input id="b-thick" type="number" value="3"><span class="u">mm</span></span></label>
        </div>
        <div class="glabel">Szczebelki</div>
        <div class="row">
          <label class="f">Ilość<span class="inp"><input id="b-count" type="number" value="10"><span class="u">szt</span></span></label><span></span>
          <label class="f">Szerokość<span class="inp"><input id="b-pw" type="number" value="8"><span class="u">cm</span></span></label>
          <label class="f">Głębokość<span class="inp"><input id="b-pd" type="number" value="2"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Rozstaw szczebelków</div>
        <div class="seg" data-seg="b">
          <button data-m="edges" class="on">Równe odstępy (także przy ramie)</button>
          <button data-m="between">Równe tylko między szczeblami</button>
        </div>
      </div>
      <div class="stack">
        <div class="card"><div class="chead">Rysunek — widok z przodu</div><div id="b-draw" class="draw"></div></div>
        <div class="card"><div class="chead">✂ Lista cięć <span class="muted">(mm)</span></div>
          <table><thead><tr><th>Element</th><th>Ilość</th><th>Długość</th><th>Cięcie</th></tr></thead><tbody id="b-cuts"></tbody></table></div>
        <div class="card"><div class="chead">Materiał i masa</div><div class="mgrid" id="b-mat"></div><p class="note" id="b-note"></p></div>
      </div>
    </div>
  </section>

  <!-- ================= FURTKA ================= -->
  <section id="page-furtka" class="hide">
    <div class="grid">
      <div class="card panel panel-col">
        <div class="glabel">Światło (między słupami)</div>
        <div class="row">
          <label class="f">Szerokość<span class="inp"><input id="f-width" type="number" value="100"><span class="u">cm</span></span></label>
          <label class="f">Wysokość<span class="inp"><input id="f-height" type="number" value="150"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Zamek</div>
        <div class="seg" data-seg="f-lock">
          <button data-m="elektro" class="on">Z elektrozaczepem (−10 cm)</button>
          <button data-m="zwykly">Bez elektrozaczepu (−8 cm)</button>
        </div>
        <div class="glabel">Profil ramy</div>
        <div class="row">
          <label class="f">Bok<span class="inp"><input id="f-face" type="number" value="10"><span class="u">cm</span></span></label>
          <label class="f">Grubość<span class="inp"><input id="f-thick" type="number" value="3"><span class="u">mm</span></span></label>
        </div>
        <div class="glabel">Szczebelki</div>
        <div class="row">
          <label class="f">Ilość<span class="inp"><input id="f-count" type="number" value="4"><span class="u">szt</span></span></label><span></span>
          <label class="f">Szerokość<span class="inp"><input id="f-pw" type="number" value="8"><span class="u">cm</span></span></label>
          <label class="f">Głębokość<span class="inp"><input id="f-pd" type="number" value="2"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Rozstaw szczebelków</div>
        <div class="seg" data-seg="f">
          <button data-m="edges" class="on">Równe odstępy (także przy ramie)</button>
          <button data-m="between">Równe tylko między szczeblami</button>
        </div>
      </div>
      <div class="stack">
        <div id="f-hint" class="info" style="margin-bottom:20px"></div>
        <div class="card"><div class="chead">Rysunek — widok z przodu</div><div id="f-draw" class="draw"></div></div>
        <div class="card"><div class="chead">✂ Lista cięć <span class="muted">(mm)</span></div>
          <table><thead><tr><th>Element</th><th>Ilość</th><th>Długość</th><th>Cięcie</th></tr></thead><tbody id="f-cuts"></tbody></table></div>
        <div class="card"><div class="chead">Materiał i masa</div><div class="mgrid" id="f-mat"></div><p class="note" id="f-note"></p></div>
      </div>
    </div>
  </section>

  <!-- ================= BRAMA 2-SKRZYDŁOWA ================= -->
  <section id="page-double" class="hide">
    <div class="grid">
      <div class="card panel panel-col">
        <div class="glabel">Światło (między słupami)</div>
        <div class="row">
          <label class="f">Szerokość<span class="inp"><input id="d-width" type="number" value="400"><span class="u">cm</span></span></label>
          <label class="f">Wysokość<span class="inp"><input id="d-height" type="number" value="150"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Profil ramy</div>
        <div class="row">
          <label class="f">Bok<span class="inp"><input id="d-face" type="number" value="10"><span class="u">cm</span></span></label>
          <label class="f">Grubość<span class="inp"><input id="d-thick" type="number" value="3"><span class="u">mm</span></span></label>
        </div>
        <div class="glabel">Szczebelki <span style="text-transform:none;font-weight:400">(na skrzydło)</span></div>
        <div class="row">
          <label class="f">Ilość<span class="inp"><input id="d-count" type="number" value="8"><span class="u">szt</span></span></label><span></span>
          <label class="f">Szerokość<span class="inp"><input id="d-pw" type="number" value="8"><span class="u">cm</span></span></label>
          <label class="f">Głębokość<span class="inp"><input id="d-pd" type="number" value="2"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Rozstaw szczebelków</div>
        <div class="seg" data-seg="d">
          <button data-m="edges" class="on">Równe odstępy (także przy ramie)</button>
          <button data-m="between">Równe tylko między szczeblami</button>
        </div>
      </div>
      <div class="stack">
        <div id="d-hint" class="info" style="margin-bottom:20px"></div>
        <div class="card"><div class="chead">Rysunek — widok z przodu</div><div id="d-draw" class="draw"></div></div>
        <div class="card"><div class="chead">✂ Lista cięć <span class="muted">(mm · na 2 skrzydła)</span></div>
          <table><thead><tr><th>Element</th><th>Ilość</th><th>Długość</th><th>Cięcie</th></tr></thead><tbody id="d-cuts"></tbody></table></div>
        <div class="card"><div class="chead">Materiał i masa</div><div class="mgrid" id="d-mat"></div><p class="note" id="d-note"></p></div>
      </div>
    </div>
  </section>

  <!-- ============ WYCINKA / BLACHA (trapez + otwory) ============ -->
  <section id="page-wycinka" class="hide">
    <div class="grid">
      <div class="card panel panel-col">
        <div class="glabel">Trapez — wymiary</div>
        <div class="row">
          <label class="f">Podstawa<span class="inp"><input id="w-base" type="number" value="55"><span class="u">cm</span></span></label>
          <label class="f">Grubość blachy<span class="inp"><input id="w-th" type="number" value="3"><span class="u">mm</span></span></label>
        </div>
        <div class="row">
          <label class="f">Bok lewy (wys.)<span class="inp"><input id="w-hl" type="number" value="12"><span class="u">cm</span></span></label>
          <label class="f">Bok prawy (wys.)<span class="inp"><input id="w-hr" type="number" value="8"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Otwory montażowe</div>
        <p style="font-size:11.5px;color:#94a3b8;margin:-4px 0 8px;line-height:1.45">X = od lewej · Y = wysokość od podstawy · fi puste = pomiń otwór.</p>
        <div class="row" style="grid-template-columns:1fr 1fr 1fr;gap:8px">
          <label class="f">Otw.1 X<span class="inp"><input id="w-x1" type="number" value="10"><span class="u">cm</span></span></label>
          <label class="f">Y<span class="inp"><input id="w-y1" type="number" value="1.5"><span class="u">cm</span></span></label>
          <label class="f">fi<span class="inp"><input id="w-f1" type="number" value="10"><span class="u">mm</span></span></label>
        </div>
        <div class="row" style="grid-template-columns:1fr 1fr 1fr;gap:8px">
          <label class="f">Otw.2 X<span class="inp"><input id="w-x2" type="number" value="50"><span class="u">cm</span></span></label>
          <label class="f">Y<span class="inp"><input id="w-y2" type="number" value="1.5"><span class="u">cm</span></span></label>
          <label class="f">fi<span class="inp"><input id="w-f2" type="number" value="10"><span class="u">mm</span></span></label>
        </div>
        <div class="row" style="grid-template-columns:1fr 1fr 1fr;gap:8px">
          <label class="f">Otw.3 X<span class="inp"><input id="w-x3" type="number" value=""><span class="u">cm</span></span></label>
          <label class="f">Y<span class="inp"><input id="w-y3" type="number" value=""><span class="u">cm</span></span></label>
          <label class="f">fi<span class="inp"><input id="w-f3" type="number" value=""><span class="u">mm</span></span></label>
        </div>
        <div class="row" style="grid-template-columns:1fr 1fr 1fr;gap:8px">
          <label class="f">Otw.4 X<span class="inp"><input id="w-x4" type="number" value=""><span class="u">cm</span></span></label>
          <label class="f">Y<span class="inp"><input id="w-y4" type="number" value=""><span class="u">cm</span></span></label>
          <label class="f">fi<span class="inp"><input id="w-f4" type="number" value=""><span class="u">mm</span></span></label>
        </div>
      </div>
      <div class="stack">
        <div class="card"><div class="chead">Rysunek — element do wycięcia</div><div id="w-draw" class="draw"></div></div>
        <div class="card"><div class="chead">✂ Dane do wycinki <span class="muted">(mm)</span></div>
          <table><tbody id="w-info"></tbody></table></div>
        <div class="card"><div class="chead">Materiał i masa</div><div class="mgrid" id="w-mat"></div><p class="note" id="w-note"></p></div>
      </div>
    </div>
  </section>

  <!-- ============ SCHODY (okładzina + korekta per stopień) ============ -->
  <section id="page-schody" class="hide">
    <div class="grid">
      <div class="card panel panel-col">
        <div class="glabel">Wymiary globalne (domyślne)</div>
        <div class="row">
          <label class="f">Wysokość<span class="inp"><input id="s-h" type="number" value="15" oninput="schodyGlobal()"><span class="u">cm</span></span></label>
          <label class="f">Głębokość<span class="inp"><input id="s-d" type="number" value="30" oninput="schodyGlobal()"><span class="u">cm</span></span></label>
        </div>
        <div class="row">
          <label class="f">Szerokość<span class="inp"><input id="s-w" type="number" value="100" oninput="renderSchody()"><span class="u">cm</span></span></label>
          <label class="f">Grubość okładziny <span style="color:#DC2626;font-size:11px;font-weight:600">◆</span><span class="inp"><input id="s-t" type="number" value="2" oninput="renderSchody()"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Segmenty</div>
        <p style="font-size:11.5px;color:#94a3b8;margin:-4px 0 6px;line-height:1.45">Każdy segment osobno — inna liczba stopni i wymiary. Edytuj pojedynczy stopień przy nierównej wylewce (✎ = zmieniony).</p>
        <label class="f">Liczba segmentów<span class="inp"><input id="s-segcount" type="number" value="1" oninput="schodyBuildSegs()"><span class="u">szt</span></span></label>
        <div id="s-segeditors"></div>
      </div>
      <div class="stack">
        <div id="s-output"></div>
        <div class="card"><div class="chead">Parametry (Blondel / wymiary)</div><div class="mgrid" id="s-mat"></div><p class="note" id="s-note"></p></div>
      </div>
    </div>
  </section>
<section id="page-szyba" class="hide">
    <div class="grid">
      <div class="card panel panel-col">
        <div class="glabel">Wymiary globalne (domyślne stopnie)</div>
        <div class="row">
          <label class="f">Wysokość (pion)<span class="inp"><input id="sz-h" type="number" value="15" oninput="szybaGlobal()"><span class="u">cm</span></span></label>
          <label class="f">Głębokość (poziom)<span class="inp"><input id="sz-d" type="number" value="30" oninput="szybaGlobal()"><span class="u">cm</span></span></label>
        </div>
        <div class="glabel">Tafle w projekcie</div>
        <label class="f">Liczba tafli<span class="inp"><input id="sz-segcount" type="number" value="1" oninput="szybaBuildSegs()"><span class="u">szt</span></span></label>
        <div id="sz-segeditors"></div>
      </div>
      <div class="stack"><div id="sz-output"></div></div>
    </div>
  </section>
</div>

<script>
/* ---------- stan rozstawu / trybów ---------- */
var seg={b:"edges",f:"edges",d:"edges","f-lock":"elektro"};
document.querySelectorAll(".seg").forEach(function(s){
  var key=s.dataset.seg;
  s.querySelectorAll("button").forEach(function(btn){
    btn.addEventListener("click",function(){
      seg[key]=btn.dataset.m;
      s.querySelectorAll("button").forEach(function(x){x.classList.remove("on")});
      btn.classList.add("on"); renderAll();
    });
  });
});
document.querySelectorAll("input").forEach(function(i){i.addEventListener("input",renderAll)});

/* ---------- przełączanie zakładek ---------- */
var pages={brama:"page-brama",furtka:"page-furtka",double:"page-double",wycinka:"page-wycinka",schody:"page-schody",szyba:"page-szyba"};
var typeNames={brama:"Brama / przęsło",furtka:"Furtka",double:"Brama 2-skrzydłowa",wycinka:"Wycinka / blacha",schody:"Schody",szyba:"Szyba / barierka"};
var activeType=typeNames.brama;

function activate(key){
  if(!pages[key]) key="brama";
  document.querySelectorAll("#tabs .tab").forEach(function(x){x.classList.toggle("on",x.dataset.t===key)});
  activeType=typeNames[key];
  for(var k in pages) document.getElementById(pages[k]).classList.toggle("hide",k!==key);
}
document.querySelectorAll("#tabs .tab").forEach(function(t){
  t.addEventListener("click",function(){
    activate(t.dataset.t);
    try{history.replaceState(null,"","#"+t.dataset.t);}catch(e){location.hash=t.dataset.t;}
  });
});
var initKey=(location.hash||"").replace("#","");
activate(pages[initKey]?initKey:"brama");

function inPreview(){try{return window.self!==window.top}catch(e){return true}}

function doPrint(){
  var u=(document.getElementById("uwagi").value||"").trim();
  var d=new Date().toLocaleDateString("pl-PL");
  document.getElementById("print-meta").textContent=(u?u+"  ·  ":"")+activeType+"  ·  "+d;
