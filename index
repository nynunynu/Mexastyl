}

/* ---------- helpery ---------- */
function val(id){return parseFloat(document.getElementById(id).value)||0}
function fmt(n,d){return Number(n).toLocaleString("pl-PL",{minimumFractionDigits:d||0,maximumFractionDigits:d||0})}
function fmtN(n){return (Math.round(n*100)/100).toLocaleString("pl-PL",{maximumFractionDigits:2})}
function rect(x,y,w,h,fill,sw){return '<rect x="'+x+'" y="'+y+'" width="'+w+'" height="'+h+'" fill="'+fill+'" stroke="var(--ink)" stroke-width="'+sw+'"/>';}
function line(x1,y1,x2,y2,sw){return '<line x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'" stroke="var(--ink)" stroke-width="'+sw+'"/>';}

function computeLeaf(cw,ch,face,thick,count,pw,pd,mode){
  var internalH=ch-2*face, picketLen=internalH;
  var internalW=cw-2*face, free=internalW-count*pw;
  var gaps=mode==="edges"?count+1:count-1, gap=gaps>0?free/gaps:0;
  var xs=[]; for(var i=0;i<count;i++) xs.push(mode==="edges"?face+gap*(i+1)+pw*i:face+i*(pw+gap));
  var fm=face*10, shsKgM=(fm*fm-(fm-2*thick)*(fm-2*thick))*0.00785;
  var frameLenM=(2*cw+2*ch)/100, frameKg=frameLenM*shsKgM;
  var pKgM=(pw*10)*(pd*10)*0.00785, picketLenM=count*picketLen/100, picketKg=picketLenM*pKgM;
  return {internalW:internalW,internalH:internalH,picketLen:picketLen,free:free,gap:gap,xs:xs,
    frameLenM:frameLenM,frameKg:frameKg,picketLenM:picketLenM,picketKg:picketKg,shsKgM:shsKgM,pKgM:pKgM,
    valid:free>=0&&internalH>0&&count>0};
}

/* rysuje jedno skrzydło (rama + szczebelki) z przesunięciem ox [cm] */
function frameSVG(ox,cw,ch,face,pw,xs,sw){
  var X=ox*10,W=cw*10,H=ch*10,P=face*10,PW=pw*10,s='';
  s+=rect(X,0,W,H,'var(--steel)',sw*1.4);
  s+=rect(X+P,P,W-2*P,H-2*P,'var(--paper)',sw);
  [[0,0,P,P],[W,0,W-P,P],[0,H,P,H-P],[W,H,W-P,H-P]].forEach(function(c){s+=line(X+c[0],c[1],X+c[2],c[3],sw);});
  xs.forEach(function(x){s+=rect(X+x*10,P,PW,H-2*P,'var(--picket)',sw*0.8);});
  return s;
}

function dim(x1,y1,x2,y2,label,offset,vertical,fs,sw,color){
  color=color||"var(--dim)";
  var ox=vertical?offset:0,oy=vertical?0:offset;
  var tx=(x1+x2)/2+(vertical?offset+fs*1.1:0), ty=(y1+y2)/2+(vertical?0:offset+fs*1.3);
  var g='<g stroke="'+color+'" stroke-width="'+sw+'" fill="'+color+'">';
  g+='<line x1="'+x1+'" y1="'+y1+'" x2="'+(x1+ox)+'" y2="'+(y1+oy)+'" opacity="0.5"/>';
  g+='<line x1="'+x2+'" y1="'+y2+'" x2="'+(x2+ox)+'" y2="'+(y2+oy)+'" opacity="0.5"/>';
  g+='<line x1="'+(x1+ox)+'" y1="'+(y1+oy)+'" x2="'+(x2+ox)+'" y2="'+(y2+oy)+'" marker-start="url(#a)" marker-end="url(#a)"/>';
  g+='<text x="'+tx+'" y="'+ty+'" font-size="'+fs+'" font-family="ui-monospace,monospace" text-anchor="middle" stroke="none"'+(vertical?' transform="rotate(-90 '+tx+' '+ty+')"':'')+'>'+label+'</text>';
  return g+'</g>';
}
function marker(fs){return '<defs><marker id="a" markerWidth="14" markerHeight="14" refX="'+(7*fs/14)+'" refY="'+(5*fs/14)+'" orient="auto" markerUnits="userSpaceOnUse" viewBox="0 0 10 10"><path d="M0,0 L10,5 L0,10" fill="var(--dim)" transform="scale('+(fs/14)+')"/></marker><marker id="ar" markerWidth="14" markerHeight="14" refX="'+(7*fs/14)+'" refY="'+(5*fs/14)+'" orient="auto" markerUnits="userSpaceOnUse" viewBox="0 0 10 10"><path d="M0,0 L10,5 L0,10" fill="#DC2626" transform="scale('+(fs/14)+')"/></marker></defs>';}
function dashRect(x,y,w,h,color,sw){return '<rect x="'+x+'" y="'+y+'" width="'+w+'" height="'+h+'" fill="none" stroke="'+color+'" stroke-width="'+sw+'" stroke-dasharray="'+(sw*4)+' '+(sw*3)+'"/>';}

function fillCuts(id,rows){
  document.getElementById(id).innerHTML=rows.map(function(r){
    return '<tr><td class="name">'+r[0]+'</td><td>'+r[1]+' szt</td><td style="font-weight:600">'+fmt(r[2])+' mm</td><td style="color:'+(r[4]?'var(--accent)':'var(--ink)')+'">'+r[3]+'</td></tr>';
  }).join("");
}
function fillMat(id,cells){
  document.getElementById(id).innerHTML=cells.map(function(c){
    return '<div class="mcell"><div class="k">'+c[0]+'</div><div class="v" style="color:'+(c[3]?'var(--accent)':'var(--ink)')+'">'+c[2]+'</div>'+(c[1]?'<div class="s">'+c[1]+'</div>':'')+'</div>';
  }).join("");
}

/* ============ RENDER: BRAMA / PRZĘSŁO ============ */
function renderBrama(){
  var cw=val("b-width"),ch=val("b-height"),face=val("b-face"),thick=val("b-thick"),
      count=Math.round(val("b-count")),pw=val("b-pw"),pd=val("b-pd");
  var L=computeLeaf(cw,ch,face,thick,count,pw,pd,seg.b);
  var W=cw*10,H=ch*10,maxD=Math.max(W,H),pad=maxD*0.2,fs=maxD/40,sw=fs/10;
  var dw=document.getElementById("b-draw");
  if(!L.valid){dw.innerHTML='<div class="err">Szczebelki nie mieszczą się w świetle ramy. Zmień ilość/szerokość lub wymiary.</div>';}
  else{
    var s='<svg viewBox="'+(-pad)+' '+(-pad*0.9)+' '+(W+pad*2)+' '+(H+pad*1.9)+'">'+marker(fs);
    s+=frameSVG(0,cw,ch,face,pw,L.xs,sw);
    s+=dim(0,H,W,H,fmt(W),pad*0.62,false,fs,sw);
    s+=dim(W,0,W,H,fmt(H),pad*0.62,true,fs,sw);
    if(L.xs.length>=2) s+=dim((L.xs[0]+pw)*10,face*10,L.xs[1]*10,face*10,fmt(L.gap*10),-pad*0.28,false,fs,sw);
    s+='<text x="'+(face*10+fs*0.4)+'" y="'+(-pad*0.28)+'" font-family="ui-monospace,monospace" font-size="'+(fs*0.92)+'" fill="var(--ink)">PROFIL '+fmt(face*10)+'×'+fmt(face*10)+'×'+fmt(thick)+'</text>';
    s+='</svg>'; dw.innerHTML=s;
  }
  fillCuts("b-cuts",[
    ["Profil ramy — poziomy",2,W,"45° oba końce",true],
    ["Profil ramy — pionowy",2,H,"45° oba końce",true],
    ["Szczebel "+fmt(pw*10)+"×"+fmt(pd*10),count,L.picketLen*10,"90° proste",false]]);
  fillMat("b-mat",[
    ["Profil ramy",fmt(L.frameLenM,2)+" m",fmt(L.frameKg,1)+" kg",false],
    ["Szczebelki",fmt(L.picketLenM,2)+" m",fmt(L.picketKg,1)+" kg",false],
    ["Masa całkowita","",fmt(L.frameKg+L.picketKg,1)+" kg",true],
    ["Odstęp światła",fmt(L.gap,1)+" cm",fmt(L.gap*10)+" mm",false]]);
  document.getElementById("b-note").textContent="Stal 7,85 g/cm³. Profil zamknięty "+fmt(face*10)+"×"+fmt(face*10)+"×"+fmt(thick)+", szczebelki płaskownik pełny "+fmt(pw*10)+"×"+fmt(pd*10)+". Wartości orientacyjne.";
}

/* ============ RENDER: FURTKA ============ */
function renderFurtka(){
  var sw_=val("f-width"),sh=val("f-height"),face=val("f-face"),thick=val("f-thick"),
      count=Math.round(val("f-count")),pw=val("f-pw"),pd=val("f-pd");
  var ded=seg["f-lock"]==="elektro"?10:8;
  var cw=sw_-ded, ch=sh, sideGap=ded/2;
  document.getElementById("f-hint").innerHTML="Światło <b>"+fmt(sw_)+"×"+fmt(sh)+"</b> · "+(seg["f-lock"]==="elektro"?"z elektrozaczepem −10 cm":"bez elektrozaczepu −8 cm")+" → konstrukcja furtki <b>"+fmt(cw)+"×"+fmt(ch)+" cm</b>. Luz rozłożony po "+fmt(sideGap,1)+" cm na stronę (strona zaczepu zwykle szersza).";
  var L=computeLeaf(cw,ch,face,thick,count,pw,pd,seg.f);
  var SW=sw_*10,SH=sh*10,W=cw*10,maxD=Math.max(SW,SH),pad=maxD*0.2,fs=maxD/40,sw=fs/10;
  var dw=document.getElementById("f-draw");
  if(!L.valid||cw<=0){dw.innerHTML='<div class="err">Konstrukcja wychodzi za mała lub szczebelki się nie mieszczą. Zmień światło / szczebelki.</div>';}
  else{
    var s='<svg viewBox="'+(-pad)+' '+(-pad*0.9)+' '+(SW+pad*2)+' '+(SH+pad*1.9)+'">'+marker(fs);
    s+=dashRect(0,0,SW,SH,'var(--swiatlo)',sw);                 // światło
    s+=frameSVG(sideGap,cw,ch,face,pw,L.xs,sw);                 // furtka wyśrodkowana
    s+=dim(0,SH,SW,SH,fmt(SW),pad*0.62,false,fs,sw,'var(--swiatlo)');   // światło szer.
    s+=dim(SW,0,SW,SH,fmt(SH),pad*0.62,true,fs,sw);                     // wysokość
    s+=dim(0,0,sideGap*10,0,fmt(sideGap*10),-pad*0.28,false,fs,sw);     // luz lewy
    s+=dim((sideGap+cw)*10,0,SW,0,fmt(sideGap*10),-pad*0.28,false,fs,sw); // luz prawy
    s+='<text x="'+(sideGap*10+fs*0.4)+'" y="'+(SH+pad*0.32)+'" font-family="ui-monospace,monospace" font-size="'+(fs*0.9)+'" fill="var(--ink)">konstrukcja '+fmt(W)+' szer.</text>';
    s+='</svg>'; dw.innerHTML=s;
  }
  fillCuts("f-cuts",[
    ["Profil ramy — poziomy",2,cw*10,"45° oba końce",true],
    ["Profil ramy — pionowy",2,ch*10,"45° oba końce",true],
    ["Szczebel "+fmt(pw*10)+"×"+fmt(pd*10),count,L.picketLen*10,"90° proste",false]]);
  fillMat("f-mat",[
    ["Profil ramy",fmt(L.frameLenM,2)+" m",fmt(L.frameKg,1)+" kg",false],
    ["Szczebelki",fmt(L.picketLenM,2)+" m",fmt(L.picketKg,1)+" kg",false],
    ["Masa całkowita","",fmt(L.frameKg+L.picketKg,1)+" kg",true],
    ["Odstęp światła",fmt(L.gap,1)+" cm",fmt(L.gap*10)+" mm",false]]);
  document.getElementById("f-note").textContent="Konstrukcja "+fmt(cw)+"×"+fmt(ch)+" cm ze światła "+fmt(sw_)+"×"+fmt(sh)+". Odstęp na zamek "+ded+" cm ("+(seg["f-lock"]==="elektro"?"elektrozaczep":"zamek zwykły")+"). Masy orientacyjne, stal 7,85 g/cm³.";
}

/* ============ RENDER: BRAMA 2-SKRZYDŁOWA ============ */
function renderDouble(){
  var sw_=val("d-width"),sh=val("d-height"),face=val("d-face"),thick=val("d-thick"),
      count=Math.round(val("d-count")),pw=val("d-pw"),pd=val("d-pd");
  var outer=7.5, lock=1;                       // luz zawias / zamek [cm]
  var ded=2*outer+lock;                         // całkowite odjęcie = 16 cm
  var leafW=(sw_-ded)/2, ch=sh;
  document.getElementById("d-hint").innerHTML="Światło <b>"+fmt(sw_)+"×"+fmt(sh)+"</b> · odejmujemy "+fmt(ded)+" cm (2×"+fmt(outer,1)+" zawias + "+fmt(lock)+" zamek) → każde skrzydło <b>"+fmt(leafW,1)+"×"+fmt(ch)+" cm</b>. Szczelina zamka "+fmt(lock)+" cm zaznaczona między skrzydłami.";
  var L=computeLeaf(leafW,ch,face,thick,count,pw,pd,seg.d);
  var SW=sw_*10,SH=sh*10,W=leafW*10,maxD=Math.max(SW,SH),pad=maxD*0.2,fs=maxD/40,sw=fs/10;
  var leaf2x=outer+leafW+lock, lockC=outer+leafW+lock/2;   // skrzydło prawe / środek zamka [cm]
  var dw=document.getElementById("d-draw");
  if(!L.valid||leafW<=0){dw.innerHTML='<div class="err">Skrzydła wychodzą za małe lub szczebelki się nie mieszczą. Zmień światło / szczebelki.</div>';}
  else{
    var s='<svg viewBox="'+(-pad)+' '+(-pad*0.9)+' '+(SW+pad*2)+' '+(SH+pad*1.9)+'">'+marker(fs);
    s+=dashRect(0,0,SW,SH,'var(--swiatlo)',sw);          // światło
    s+=frameSVG(outer,leafW,ch,face,pw,L.xs,sw);         // skrzydło lewe
    s+=frameSVG(leaf2x,leafW,ch,face,pw,L.xs,sw);        // skrzydło prawe
    s+=dashRect((lockC-lock/2)*10,face*10,lock*10,SH-2*face*10,'var(--accent)',sw*1.3); // symbol zamka 1 cm
    s+=dim(0,SH,SW,SH,fmt(SW),pad*0.62,false,fs,sw,'var(--swiatlo)');   // światło szer.
    s+=dim(SW,0,SW,SH,fmt(SH),pad*0.62,true,fs,sw);                     // wysokość
    s+=dim(0,0,outer*10,0,fmt(outer*10),-pad*0.28,false,fs,sw);         // luz lewy
    s+=dim((sw_-outer)*10,0,SW,0,fmt(outer*10),-pad*0.28,false,fs,sw);  // luz prawy
    s+=dim(outer*10,SH*0.4,(outer+leafW)*10,SH*0.4,fmt(W),-pad*0.05,false,fs,sw); // szer. skrzydła
    s+='<text x="'+(lockC*10)+'" y="'+(-pad*0.5)+'" font-family="ui-monospace,monospace" font-size="'+(fs*0.9)+'" fill="var(--accent)" text-anchor="middle">zamek '+fmt(lock*10)+' mm</text>';
    s+='</svg>'; dw.innerHTML=s;
  }
  var one=L.frameKg+L.picketKg;
  fillCuts("d-cuts",[
    ["Profil ramy — poziomy",4,leafW*10,"45° oba końce",true],
    ["Profil ramy — pionowy",4,ch*10,"45° oba końce",true],
    ["Szczebel "+fmt(pw*10)+"×"+fmt(pd*10),count*2,L.picketLen*10,"90° proste",false]]);
  fillMat("d-mat",[
    ["Profil ramy (2 skrz.)",fmt(L.frameLenM*2,2)+" m",fmt(L.frameKg*2,1)+" kg",false],
    ["Szczebelki (2 skrz.)",fmt(L.picketLenM*2,2)+" m",fmt(L.picketKg*2,1)+" kg",false],
    ["Masa całkowita","",fmt(one*2,1)+" kg",true],
    ["Odstęp światła",fmt(L.gap,1)+" cm",fmt(L.gap*10)+" mm",false]]);
  document.getElementById("d-note").textContent="Każde skrzydło "+fmt(leafW,1)+"×"+fmt(ch)+" cm = (światło "+fmt(sw_)+" − "+fmt(ded)+")÷2, gdzie 16 cm = 2×"+fmt(outer,1)+" zawias + "+fmt(lock)+" zamek. Masy dla 2 skrzydeł, stal 7,85 g/cm³, orientacyjnie.";
}

function renderWycinka(){
  var base=val("w-base"),hl=val("w-hl"),hr=val("w-hr"),th=val("w-th");
  var holes=[];
  for(var i=1;i<=4;i++){var f=val("w-f"+i); if(f>0) holes.push({x:val("w-x"+i),y:val("w-y"+i),f:f});}
  var dw=document.getElementById("w-draw");
  if(base<=0||hl<=0||hr<=0){dw.innerHTML='<div class="err">Podaj dodatnie wymiary trapezu (podstawa i boki).</div>';
    document.getElementById("w-info").innerHTML="";document.getElementById("w-mat").innerHTML="";document.getElementById("w-note").textContent="";return;}
  var B=base*10,HL=hl*10,HR=hr*10,Hmax=Math.max(HL,HR);
  var maxD=Math.max(B,Hmax),pad=maxD*0.26,fs=maxD/26,sw=fs/10;
  var dc='stroke-dasharray="'+(sw*3)+' '+(sw*2)+'"';
  var s='<svg viewBox="'+(-pad*1.5)+' '+(-pad*2.2)+' '+(B+pad*3.0)+' '+(Hmax+pad*4.0)+'">'+marker(fs);
  s+='<polygon points="0,'+Hmax+' '+B+','+Hmax+' '+B+','+(Hmax-HR)+' 0,'+(Hmax-HL)+'" fill="var(--steel)" stroke="var(--ink)" stroke-width="'+(sw*1.4)+'"/>';
  // pozioma oś przez otwory (jeśli istnieją)
  if(holes.length){var cyc=Hmax-holes[0].y*10;
    s+='<line x1="'+(-pad*0.35)+'" y1="'+cyc+'" x2="'+(B+pad*0.35)+'" y2="'+cyc+'" stroke="var(--dim)" stroke-width="'+(sw*0.6)+'" '+dc+' opacity="0.55"/>';}
  holes.forEach(function(h,i){
    var cx=h.x*10,cy=Hmax-h.y*10,r=h.f/2;
    // pionowa oś przez otwór
    s+='<line x1="'+cx+'" y1="'+(-pad*0.7)+'" x2="'+cx+'" y2="'+Hmax+'" stroke="var(--dim)" stroke-width="'+(sw*0.6)+'" '+dc+' opacity="0.5"/>';
    s+='<circle cx="'+cx+'" cy="'+cy+'" r="'+r+'" fill="var(--paper)" stroke="var(--ink)" stroke-width="'+sw+'"/>';
    s+='<line x1="'+(cx-r*1.7)+'" y1="'+cy+'" x2="'+(cx+r*1.7)+'" y2="'+cy+'" stroke="var(--ink)" stroke-width="'+(sw*0.6)+'"/><line x1="'+cx+'" y1="'+(cy-r*1.7)+'" x2="'+cx+'" y2="'+(cy+r*1.7)+'" stroke="var(--ink)" stroke-width="'+(sw*0.6)+'"/>';
    // Ø z odnośnikiem
    var lx=cx+fs*1.1, ly=cy-r-fs*1.2;
    s+='<line x1="'+(cx+r*0.7)+'" y1="'+(cy-r*0.7)+'" x2="'+lx+'" y2="'+ly+'" stroke="var(--accent)" stroke-width="'+(sw*0.7)+'"/>';
    s+='<text x="'+(lx+fs*0.3)+'" y="'+(ly-fs*0.15)+'" font-size="'+(fs*0.8)+'" font-family="ui-monospace,monospace" fill="var(--accent)">Ø'+fmt(h.f)+' mm</text>';
    // X (od lewej) nad płytą, pietrowo
    var xlev=-pad*(0.8+i*0.62);
    s+=dim(0,0,cx,0,fmt(h.x)+' cm'+((holes.length>1&&i===holes.length-1)?'  (od kraw.)':''),xlev,false,fs*0.9,sw);
    // wysokość (mm) OBOK otworu, opis poziomo i czytelnie
    var right=cx<B/2, mx=cx+(right?pad*0.52:-pad*0.52);
    s+='<g stroke="#DC2626" stroke-width="'+sw+'" fill="#DC2626">';
    s+='<line x1="'+cx+'" y1="'+Hmax+'" x2="'+mx+'" y2="'+Hmax+'" opacity="0.55"/><line x1="'+cx+'" y1="'+cy+'" x2="'+mx+'" y2="'+cy+'" opacity="0.55"/>';
    s+='<line x1="'+mx+'" y1="'+Hmax+'" x2="'+mx+'" y2="'+cy+'" marker-start="url(#ar)" marker-end="url(#ar)"/>';
    s+='<text x="'+(mx+(right?fs*0.45:-fs*0.45))+'" y="'+((Hmax+cy)/2+fs*0.35)+'" font-size="'+(fs*0.92)+'" font-weight="700" font-family="ui-monospace,monospace" fill="#DC2626" stroke="none" text-anchor="'+(right?'start':'end')+'">'+fmt(h.y*10)+' mm</text></g>';
  });
  s+=dim(0,Hmax,B,Hmax,fmt(base)+' cm',pad*0.7,false,fs,sw);
  s+=dim(0,Hmax-HL,0,Hmax,fmt(hl)+' cm',-pad*0.6,true,fs,sw);
  s+=dim(B,Hmax-HR,B,Hmax,fmt(hr)+' cm',pad*0.6,true,fs,sw);
  s+='</svg>'; dw.innerHTML=s;

  var slant=Math.sqrt(B*B+(HL-HR)*(HL-HR));
  function ir(k,v){return '<tr><td class="name">'+k+'</td><td style="text-align:right">'+v+'</td></tr>';}
  var info=ir("Podstawa",fmt(B)+" mm")+ir("Bok lewy",fmt(HL)+" mm")+ir("Bok prawy",fmt(HR)+" mm")+ir("Góra (skos)",fmt(slant,0)+" mm");
  holes.forEach(function(h,i){info+=ir("Otwór "+(i+1),"fi "+fmt(h.f)+" · X="+fmt(h.x*10)+" · Y="+fmt(h.y*10));});
  document.getElementById("w-info").innerHTML=info;

  var area=(hl+hr)/2*base, kg=area*(th/10)*0.00785, perim=(B+HL+HR+slant)/10;
  fillMat("w-mat",[
    ["Pole blachy","",fmt(area,0)+" cm²",false],
    ["Masa (stal)","",fmt(kg,2)+" kg",true],
    ["Grubość","",fmt(th)+" mm",false],
    ["Otwory","",holes.length+"× fi",false]]);
  document.getElementById("w-note").textContent="Trapez z blachy "+fmt(th)+" mm · kontur + "+holes.length+" otw. montażowych. Obwód cięcia ≈ "+fmt(perim,0)+" cm. Wymiary w mm, masa dla stali 7,85 g/cm³.";
